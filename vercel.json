{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "public/index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ],
  "functions": {
    "api/pdf.js": {
      "maxDuration": 60
    },
    "api/generate.js": {
      "maxDuration": 300
    },
    "api/prompts.js": {
      "maxDuration": 30
    }
  }
}
