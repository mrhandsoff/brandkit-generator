{
  "version": 2,
  "functions": {
    "api/generate.js": { "maxDuration": 300 },
    "api/prompts.js":  { "maxDuration": 30 },
    "api/save.js":     { "maxDuration": 60 },
    "api/kit.js":      { "maxDuration": 10 },
    "api/pdf.js":      { "maxDuration": 60 }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/kit",      "dest": "/kit.html" },
    { "src": "/(.*)",     "dest": "/index.html" }
  ]
}
